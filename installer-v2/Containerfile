ARG INSTALLER_BASE_IMAGE=quay.io/fedora/fedora-bootc:44
FROM ${INSTALLER_BASE_IMAGE}

# Explicit components avoid the metapackage's legacy GTK frontend.
RUN dnf install -y \
    anaconda-core \
    anaconda-install-img-deps \
    anaconda-dracut \
    anaconda-webui \
    firefox \
    dbus-glib \
    dracut-config-generic \
    dracut-network \
    net-tools \
    grub2-common \
    grub2-pc-modules \
    grub2-efi-x64 \
    grub2-efi-x64-cdboot \
    shim-x64 \
    plymouth \
    default-fonts-core-sans \
    default-fonts-other-sans \
    google-noto-sans-cjk-fonts \
    xorriso \
    squashfs-tools \
    jq \
    && dnf clean all

# image-builder expects EFI binaries here rather than in bootc's payload store.
RUN mkdir -p /boot/efi \
    && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

# COPY paths use the repository root as the build context.
COPY installer-v2/iso.yaml /usr/lib/image-builder/bootc/iso.yaml
COPY installer-v2/interactive-defaults.ks /usr/share/anaconda/interactive-defaults.ks

# Reproduce Lorax's temporary boot.iso environment, never target OS accounts.
# Reference: https://osbuild.org/docs/developer-guide/projects/image-builder/advanced/bootc/isos/
RUN printf '%s\n' 'install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda' >> /etc/passwd \
    && printf '%s\n' 'install::14438:0:99999:7:::' >> /etc/shadow \
    && passwd -d root \
    && mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives \
    && mv /etc/yum.repos.d /etc/anaconda.repos.d \
    && ln -sfn /usr/lib/systemd/system/anaconda.target /etc/systemd/system/default.target \
    && rm /usr/lib/systemd/system-generators/systemd-gpt-auto-generator

# Reserve the alternate VT for Anaconda's troubleshooting shell.
RUN ln -sfn /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service \
    && mkdir -p /usr/lib/systemd/logind.conf.d \
    && printf '%s\n' '[Login]' 'ReserveVT=2' > /usr/lib/systemd/logind.conf.d/anaconda-shell.conf

# Installer hardware varies; include Anaconda stage2 discovery in the initramfs.
RUN mkdir -p "$(realpath /root)" \
    && kernel=$(kernel-install list --json pretty | jq -er '.[] | select(.has_kernel == true) | .version') \
    && DRACUT_NO_XATTR=1 dracut --force --zstd --reproducible --no-hostonly \
        --add anaconda "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"

# The temporary graphical installer runs as root and needs PipeWire available.
RUN mkdir -p /etc/systemd/user/pipewire.service.d /etc/systemd/user/pipewire.socket.d \
    && printf '%s\n' '[Unit]' 'ConditionUser=' > /etc/systemd/user/pipewire.service.d/allowroot.conf \
    && printf '%s\n' '[Unit]' 'ConditionUser=' > /etc/systemd/user/pipewire.socket.d/allowroot.conf
